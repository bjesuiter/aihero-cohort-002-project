# @currentEnv=$DEV_ENV
# ---

# Local profile selector. Common scripts set DEV_ENV=jb inline.
# @type=enum(development, jb, test, production) @sensitive=false
DEV_ENV=development

# Anthropic API key used by the chat route.
# JB profile source: keychain(service="varlock", account="aihero-cohort-002-project:jb:ANTHROPIC_API_KEY")
# @optional @sensitive @type=string(minLength=1) @auditIgnore
ANTHROPIC_API_KEY=

# Google Generative AI API key for model/provider experiments.
# JB profile source: keychain(service="varlock", account="aihero-cohort-002-project:jb:GOOGLE_GENERATIVE_AI_API_KEY")
# @optional @sensitive @type=string(minLength=1) @auditIgnore
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI API key for model/provider experiments.
# JB profile source: keychain(service="varlock", account="aihero-cohort-002-project:jb:OPENAI_API_KEY")
# @optional @sensitive @type=string(minLength=1) @auditIgnore
OPENAI_API_KEY=

# API key for opencode zen provider requests.
# JB profile source: keychain(service="varlock", account="aihero-cohort-002-project:jb:OPENCODE_ZEN_API_KEY")
# @optional @sensitive @type=string(minLength=1)
OPENCODE_ZEN_API_KEY=

# Base endpoint for opencode zen provider requests.
# @optional @type=url @sensitive=false @auditIgnore
OPENCODE_ZEN_API_ENDPOINT=
